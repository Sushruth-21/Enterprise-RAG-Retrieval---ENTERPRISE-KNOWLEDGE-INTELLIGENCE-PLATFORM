# ============================================================
# Enterprise Knowledge Intelligence Platform — Backend .env
# Copy this to .env and fill in your values.
# ============================================================

# ──────────────────────────────────────────────────
# DATABASE — Person 3 sets up PostgreSQL + pgvector
# Ask Person 3 for the connection details
# ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ekp_user:ekp_password@localhost:5432/enterprise_rag

# ──────────────────────────────────────────────────
# OLLAMA — Local AI (runs on your RTX 4050 laptop)
# Install from: https://ollama.com/download/windows
# Then run: ollama pull qwen2.5:3b
# ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60

# ──────────────────────────────────────────────────
# CLOUD AI — Get Gemini key FREE at:
# https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────
CLOUD_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_ACTUAL_KEY
CLOUD_MODEL_NAME=gemini-2.0-flash
ENABLE_CLOUD_FALLBACK=true

# If using OpenAI instead:
# CLOUD_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CLOUD_MODEL_NAME=gpt-4o-mini

# If using Anthropic instead:
# CLOUD_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLOUD_MODEL_NAME=claude-3-haiku-20240307

# ──────────────────────────────────────────────────
# TEAMMATE SERVICE URLS
# Update these when each person's service is ready.
# Until then, run the mock servers.
# ──────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8001
RETRIEVAL_API_URL=http://localhost:8002
INGESTION_API_URL=http://localhost:8003
# Person 2 contract paths. For the mock use /ingest; for the real service use /upload.
INGESTION_UPLOAD_PATH=/ingest
INGESTION_STATUS_PATH=/status
INGESTION_MAX_FILE_SIZE_MB=50

# ──────────────────────────────────────────────────
# BACKEND SETTINGS
# ──────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=4096
LOG_LEVEL=INFO
# Generate a proper secret key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Person 5's frontend URL — add their dev server here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]
